/* pages/index/index.wxss */
.banner {
  position: relative;
  background: linear-gradient(135deg, #2b4ea2, #4a72d4);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 78, 162, 0.3);
  overflow: hidden;
}

/* 书院徽标猴子：半透明挂在横幅右下角 */
.banner-mascot {
  position: absolute;
  right: -14rpx;
  bottom: -18rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  opacity: 0.9;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}

.banner-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.banner-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.banner-week {
  text-align: right;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 14rpx;
  padding: 8rpx 18rpx;
}

.banner-week-label {
  font-size: 26rpx;
  font-weight: 600;
}

.banner-week-range {
  font-size: 22rpx;
  opacity: 0.9;
}

.banner-phase {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.banner-phase-name {
  font-size: 27rpx;
  font-weight: 600;
}

.banner-phase-idx {
  font-size: 22rpx;
  opacity: 0.85;
}

.banner-phase-tip {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.steps {
  display: flex;
  margin-top: 18rpx;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

.step-on .step-dot {
  background: #fff;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.2);
}

.step-name {
  font-size: 20rpx;
  margin-top: 8rpx;
  opacity: 0.75;
}

.step-on .step-name {
  opacity: 1;
  font-weight: 600;
}

.go-btn {
  font-size: 25rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

/* 折叠卡片 */
.sec-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.arrow {
  font-size: 40rpx;
  color: var(--text-weak);
  transform: rotate(90deg);
  transition: transform 0.2s;
  line-height: 1;
}

.arrow-up {
  transform: rotate(-90deg);
}

.block-text {
  display: block;
}

.bullet {
  display: flex;
  margin-bottom: 8rpx;
}

.bullet-dot {
  color: var(--primary);
  margin-right: 10rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.bullet-text {
  flex: 1;
}

/* 表格 */
.table {
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
  margin: 12rpx 0;
}

.tr {
  display: flex;
  border-bottom: 2rpx solid var(--line);
}

.tr:last-child {
  border-bottom: none;
}

.tr-head {
  background: var(--primary-soft);
}

.td {
  padding: 14rpx 12rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: #374151;
  word-break: break-all;
}

.td-head {
  font-weight: 600;
  color: #2b4ea2;
}

/* 三张照片位卡片 */
.slot-card {
  display: flex;
  align-items: flex-start;
  background: var(--primary-soft);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.slot-no {
  font-size: 30rpx;
  color: var(--primary);
  margin-right: 16rpx;
  font-weight: 700;
}

/* 快捷入口 */
.quick {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  margin-top: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(23, 43, 33, 0.05);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #374151;
}

.quick-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.footnote {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
  padding: 24rpx 0 10rpx;
}
