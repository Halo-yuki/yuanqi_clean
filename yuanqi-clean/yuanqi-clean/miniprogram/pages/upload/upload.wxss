/* pages/upload/upload.wxss */
.picker {
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
}

.slot {
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.slot-hd {
  display: flex;
  align-items: flex-start;
}

.slot-no {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  margin-right: 14rpx;
}

.slot-body {
  margin-top: 16rpx;
}

.photo-box {
  position: relative;
  width: 100%;
  height: 300rpx;
}

.photo {
  width: 100%;
  height: 300rpx;
  border-radius: 14rpx;
  background: #eef1f4;
}

.photo-del {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 32rpx;
}

.photo-empty {
  height: 220rpx;
  border: 3rpx dashed #cfd6dd;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafbfc;
}

.photo-plus {
  font-size: 60rpx;
  color: var(--primary);
  line-height: 1;
  margin-bottom: 8rpx;
}

.rule-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 18rpx;
}

.record {
  border-top: 2rpx solid var(--line);
  padding: 20rpx 0;
}

.record:first-of-type {
  border-top: none;
}

.thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 10rpx;
  margin-right: 10rpx;
  background: #eef1f4;
}
